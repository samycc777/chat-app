# Copy to .env or set these as service variables on Railway. Placeholders only: never commit real
# values. README.md ("Configuration") explains each one in more detail.

# "production" on the live server. In production the server refuses to start if a required
# variable is missing or too short.
NODE_ENV=development
# Port the server listens on. Railway sets it by itself.
# PORT=3001
# Random secret of at least 32 characters that signs sessions (required in production).
JWT_SECRET=local-development-only-change-me
# Persistent directory for the database and its backups/ folder; a Railway Volume in production.
DATA_DIR=.
# Comma-separated exact origins allowed to use the site (required in production).
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173

# The secret inside the home room's invite link (at least 12 characters in production).
# Development uses 0000 when it is unset.
INVITE_KEY=0000
# Set to 1 to let the site's plain address work like the invite link.
# OPEN_JOIN=
# The home room's name, shown on the join screen and under the home-screen icon.
# SERVER_NAME=
# Secret that allows making and managing customers' rooms on the live site (/new?key=...).
# ROOM_CREATION_KEY=

# Our own LiveKit server on Hetzner, not LiveKit Cloud (see docs/notes/call-server.md).
# Without these the app opens but calls cannot start.
# LIVEKIT_URL=wss://calls.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Notifications for the Android app: the Firebase service account JSON, whole or in base64.
# FCM_SERVICE_ACCOUNT=
# Notifications for the iPhone app: the .p8 key's contents (or base64), its Key ID and the Team ID.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# The iPhone app's bundle ID (default com.samycc777.majlis).
# APNS_BUNDLE_ID=
# Set to false only for an iPhone app run straight from Xcode.
# APNS_PRODUCTION=
