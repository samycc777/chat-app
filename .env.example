# Development defaults. Production requires the variables below to be set.
NODE_ENV=development
JWT_SECRET=local-development-only-change-me
DATA_DIR=.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173
MAX_UPLOAD_BYTES=10485760
# Students join with CLASS_CODE and the teacher joins with TEACHER_CODE, on the website or in the
# Android app. Production requires both: CLASS_CODE of at least 6 characters and TEACHER_CODE of
# at least 8. Changing either code signs out everyone who joined with the old one.
CLASS_CODE=0000
TEACHER_CODE=teacher
# Optional name shown on the join screen and in the header, for example "Arabic - Level 1".
# CLASS_NAME=
# LiveKit Cloud credentials for encrypted lesson streaming. Set these as secrets;
# do not commit real values. Recording and egress are intentionally not used.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
