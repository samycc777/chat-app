# Development defaults. Production requires the variables below to be set.
NODE_ENV=development
JWT_SECRET=local-development-only-change-me
DATA_DIR=.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173
MAX_UPLOAD_BYTES=10485760
