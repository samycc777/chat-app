# Development defaults. Production requires the variables below to be set.
NODE_ENV=development
JWT_SECRET=local-development-only-change-me
DATA_DIR=.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173
MAX_UPLOAD_BYTES=10485760
# LiveKit Cloud credentials for encrypted lesson streaming. Set these as secrets;
# do not commit real values. Recording and egress are intentionally not used.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
